{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/packages/cspell-types/cspell.schema.json",
  "allowCompoundWords": true,
  "caseSensitive": true,
  "dictionaries": [
    "!aws",
    "!cryptocurrencies",
    "bash",
    "coding-compound-terms",
    "companies",
    "computing-acronyms",
    "css",
    "en_us",
    "en-us-common-misspellings",
    "filetypes",
    "fonts",
    "fullstack",
    "git",
    "html-symbol-entities",
    "html",
    "misc",
    "node",
    "npm",
    "public-licenses",
    "shellscript",
    "software-terms-alternative",
    "software-tools",
    "softwareTerms",
    "typescript"
  ],
  "flagWords": ["regardles", "nodejs", "NodeJS", "NPM"],
  "ignorePaths": [
    ".husky",
    ".vscode",
    "cspell.json",
    "tsconfig.json",
    "dist",
    "public",
    "src/assets"
  ],
  "ignoreRandomStrings": true,
  "ignoreWords": ["seti", "entropoetry", "filterenv", "rezeplayer"],
  "suggestWords": ["nodejs: Node.js", "NPM: npm"],
  "words": [
    "frobnicate",
    "endomoat",
    "keccak",
    "Kowal",
    "naugtur",
    "Devcon",
    "Endo",
    "OCAP",
    "Consensys",
    "Laverna",
    "laverna",
    "virtualizes",
    "Kipuka",
    "radio-canada"
  ]
}
